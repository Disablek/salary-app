<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1765471816491-3" author="disable">
        <dropForeignKeyConstraint baseTableName="coefficients_rule"
                                  constraintName="fk_coefficientsrule_on_coefficient"/>
    </changeSet>
    <changeSet id="1765471816491-1" author="disable">
        <createTable tableName="coefficient_rules">
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_coefficient_rules"/>
            </column>
            <column name="coefficient_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="match_value" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="multiplier" type="DECIMAL">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1765471816491-2" author="disable">
        <addForeignKeyConstraint baseColumnNames="coefficient_id" baseTableName="coefficient_rules"
                                 constraintName="FK_COEFFICIENT_RULES_ON_COEFFICIENT" referencedColumnNames="id"
                                 referencedTableName="coefficients"/>
    </changeSet>
    <changeSet id="1765471816491-4" author="disable">
        <dropTable cascadeConstraints="true" tableName="coefficients_rule"/>
    </changeSet>

</databaseChangeLog>