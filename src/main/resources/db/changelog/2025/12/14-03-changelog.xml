<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1765714715023-1" author="disable">
        <addColumn tableName="coefficients">
            <column name="base_column_id" type="uuid"/>
            <column name="source_column_id" type="uuid"/>
        </addColumn>
    </changeSet>
    <changeSet id="1765714715023-3" author="disable">
        <addForeignKeyConstraint baseColumnNames="base_column_id" baseTableName="coefficients"
                                 constraintName="FK_COEFFICIENTS_ON_BASE_COLUMN" referencedColumnNames="id"
                                 referencedTableName="columns"/>
    </changeSet>
    <changeSet id="1765714715023-4" author="disable">
        <addForeignKeyConstraint baseColumnNames="source_column_id" baseTableName="coefficients"
                                 constraintName="FK_COEFFICIENTS_ON_SOURCE_COLUMN" referencedColumnNames="id"
                                 referencedTableName="columns"/>
    </changeSet>

</databaseChangeLog>