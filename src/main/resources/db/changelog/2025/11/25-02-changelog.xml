<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1764094998614-7" author="disable">
        <dropForeignKeyConstraint baseTableName="rows_cells" constraintName="fk_rowcel_on_cell"/>
    </changeSet>
    <changeSet id="1764094998614-8" author="disable">
        <dropForeignKeyConstraint baseTableName="rows_cells" constraintName="fk_rowcel_on_row"/>
    </changeSet>
    <changeSet id="1764094998614-9" author="disable">
        <dropForeignKeyConstraint baseTableName="tables_type" constraintName="fk_tabtyp_on_column"/>
    </changeSet>
    <changeSet id="1764094998614-10" author="disable">
        <dropForeignKeyConstraint baseTableName="tables_type" constraintName="fk_tabtyp_on_data_table"/>
    </changeSet>
    <changeSet id="1764094998614-1" author="disable">
        <addColumn tableName="cells">
            <column name="cell_id" type="uuid"/>
        </addColumn>
    </changeSet>
    <changeSet id="1764094998614-2" author="disable">
        <addColumn tableName="columns">
            <column name="column_id" type="uuid"/>
        </addColumn>
    </changeSet>
    <changeSet id="1764094998614-3" author="disable">
        <addColumn tableName="rows">
            <column name="row_id" type="uuid"/>
        </addColumn>
    </changeSet>
    <changeSet id="1764094998614-4" author="disable">
        <addForeignKeyConstraint baseColumnNames="cell_id" baseTableName="cells" constraintName="FK_CELLS_ON_CELL"
                                 referencedColumnNames="id" referencedTableName="rows"/>
    </changeSet>
    <changeSet id="1764094998614-5" author="disable">
        <addForeignKeyConstraint baseColumnNames="column_id" baseTableName="columns"
                                 constraintName="FK_COLUMNS_ON_COLUMN" referencedColumnNames="id"
                                 referencedTableName="tables"/>
    </changeSet>
    <changeSet id="1764094998614-6" author="disable">
        <addForeignKeyConstraint baseColumnNames="row_id" baseTableName="rows" constraintName="FK_ROWS_ON_ROW"
                                 referencedColumnNames="id" referencedTableName="tables"/>
    </changeSet>
    <changeSet id="1764094998614-11" author="disable">
        <dropTable cascadeConstraints="true" tableName="rows_cells"/>
    </changeSet>
    <changeSet id="1764094998614-12" author="disable">
        <dropTable cascadeConstraints="true" tableName="tables_type"/>
    </changeSet>

</databaseChangeLog>