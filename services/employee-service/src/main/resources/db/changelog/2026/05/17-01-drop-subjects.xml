<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="2026-05-17-01-1-drop-empsub-fk" author="disable">
        <preConditions onFail="MARK_RAN" onFailMessage="employee_subject join table is absent, skipping FK drops">
            <tableExists tableName="employee_subject"/>
        </preConditions>
        <comment>Drop foreign keys on employee_subject join table</comment>
        <dropForeignKeyConstraint baseTableName="employee_subject"
                                  constraintName="fk_empsub_on_subject"/>
        <dropForeignKeyConstraint baseTableName="employee_subject"
                                  constraintName="fk_empsub_on_employee"/>
    </changeSet>

    <changeSet id="2026-05-17-01-2-drop-empsub-table" author="disable">
        <preConditions onFail="MARK_RAN" onFailMessage="employee_subject join table is absent, skipping drop">
            <tableExists tableName="employee_subject"/>
        </preConditions>
        <comment>Drop employee_subject join table</comment>
        <dropTable tableName="employee_subject"/>
    </changeSet>

    <changeSet id="2026-05-17-01-3-drop-subjects" author="disable">
        <preConditions onFail="MARK_RAN" onFailMessage="subjects table is absent, skipping drop">
            <tableExists tableName="subjects"/>
        </preConditions>
        <comment>Drop subjects table after Subject entity removal</comment>
        <dropTable tableName="subjects"/>
    </changeSet>

</databaseChangeLog>
